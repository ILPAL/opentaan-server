<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The wire contract is derived from the game client, so it is supplied locally
    and never committed (ADR 10). When it is present the glob copies it beside the
    test binaries, so the tests never depend on the working directory. When it is
    absent the glob matches nothing, the tests skip, and CI still runs them.
  -->
  <ItemGroup>
    <None Include="..\..\..\contracts\wire\**\*.json"
          LinkBase="contracts\wire"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The loopback client and session harness, shared with the game server's own tests. -->
  <ItemGroup>
    <Compile Include="..\OpenTaan.GameServer.Tests\Support\LoopbackClient.cs" Link="Support\LoopbackClient.cs" />
    <Compile Include="..\OpenTaan.GameServer.Tests\Support\SessionHarness.cs" Link="Support\SessionHarness.cs" />
    <Compile Include="..\OpenTaan.GameServer.Tests\Support\PlayTimeGrants.cs" Link="Support\PlayTimeGrants.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenTaan.GameServer\OpenTaan.GameServer.csproj" />
    <ProjectReference Include="..\..\src\OpenTaan.Protocol\OpenTaan.Protocol.csproj" />
    <ProjectReference Include="..\..\src\OpenTaan.Transport\OpenTaan.Transport.csproj" />
  </ItemGroup>

</Project>
